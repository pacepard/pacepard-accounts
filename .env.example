# Copy to .env.local for local dev. Set the same keys in the Vercel project
# (Settings → Environment Variables). Vite inlines only VITE_* at build time.

VITE_APP_API_URL=https://api.example.com/api/v1
VITE_APP_URL=https://accounts.example.com
VITE_ENVIRONMENT=production
VITE_APP_ENVIRONMENT=production
